{
	"name": "@fabrika/provider-cloudflare",
	"version": "0.0.4",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/provider-cloudflare"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./cli": {
			"bun": "./src/cli.ts",
			"types": "./src/cli.ts",
			"default": "./src/cli.ts"
		},
		"./runner": {
			"bun": "./src/control.ts",
			"types": "./src/control.ts",
			"default": "./src/control.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@fabrika/auth": "workspace:*",
		"@fabrika/engine": "workspace:*",
		"@fabrika/proxy-core": "workspace:*",
		"@fabrika/proxy-contract": "workspace:*",
		"@fabrika/provider-contract": "workspace:*",
		"oblaka-iac": "^0.0.18"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/bun": "latest",
		"wrangler": "4.72.0"
	}
}
