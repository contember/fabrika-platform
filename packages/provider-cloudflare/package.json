{
	"name": "@fabrika/provider-cloudflare",
	"version": "0.9.0-dev.5",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/provider-cloudflare"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./cli": {
			"bun": "./src/cli.ts",
			"types": "./src/cli.ts",
			"default": "./src/cli.ts"
		},
		"./runner": {
			"bun": "./src/control.ts",
			"types": "./src/control.ts",
			"default": "./src/control.ts"
		},
		"./installation": {
			"bun": "./src/installation/index.ts",
			"types": "./src/installation/index.ts",
			"default": "./src/installation/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"zod": "^3.25.76",
		"@fabrika/app": "workspace:*",
		"@fabrika/auth": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/check": "workspace:*",
		"@fabrika/email": "workspace:*",
		"@fabrika/iam-contract": "workspace:*",
		"@fabrika/installation-init": "workspace:*",
		"@fabrika/proxy-core": "workspace:*",
		"@fabrika/provider-contract": "workspace:*",
		"ignore": "^5.3.2",
		"oblaka-iac": "^0.0.18"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/bun": "^1.4.3",
		"wrangler": "4.74.0"
	}
}
