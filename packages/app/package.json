{
	"name": "@fabrika/app",
	"version": "0.0.4",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/app"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"skill",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./bun": {
			"bun": "./src/bun.ts",
			"types": "./src/bun.ts",
			"default": "./src/bun.ts"
		},
		"./cloudflare": {
			"bun": "./src/cloudflare.ts",
			"types": "./src/cloudflare.ts",
			"default": "./src/cloudflare.ts"
		},
		"./contract": {
			"bun": "./src/contract/index.ts",
			"types": "./src/contract/index.ts",
			"default": "./src/contract/index.ts"
		},
		"./client": {
			"bun": "./src/client/index.ts",
			"types": "./src/client/index.ts",
			"default": "./src/client/index.ts"
		},
		"./implement": {
			"bun": "./src/implement/index.ts",
			"types": "./src/implement/index.ts",
			"default": "./src/implement/index.ts"
		},
		"./build": {
			"bun": "./src/build.ts",
			"types": "./src/build.ts",
			"default": "./src/build.ts"
		},
		"./testing": {
			"bun": "./src/testing/index.ts",
			"types": "./src/testing/index.ts",
			"default": "./src/testing/index.ts"
		},
		"./testing/isolation": {
			"bun": "./src/testing/isolation.ts",
			"types": "./src/testing/isolation.ts",
			"default": "./src/testing/isolation.ts"
		},
		"./testing/preload": {
			"bun": "./src/testing/preload.ts",
			"types": "./src/testing/preload.ts",
			"default": "./src/testing/preload.ts"
		},
		"./agent-skill": {
			"bun": "./src/agent-skill.ts",
			"types": "./src/agent-skill.ts",
			"default": "./src/agent-skill.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@fabrika/auth": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/db": "workspace:*",
		"@fabrika/jwks": "workspace:*",
		"@fabrika/platform": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"@fabrika/proxy-core": "workspace:*",
		"jose": "^5.9.0"
	},
	"peerDependencies": {
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@fabrika/check": "workspace:*",
		"@types/bun": "latest",
		"kysely": "0.29.6",
		"kysely-postgres-js": "5.0.1",
		"lopata": "^0.21.0",
		"typescript": "^5.9.3",
		"zod": "^3.25.76"
	}
}
