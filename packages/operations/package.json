{
	"name": "@fabrika/operations",
	"version": "0.0.3",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/operations"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"migrations",
		"migrations-postgres",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./ingest": {
			"bun": "./src/ingest.ts",
			"types": "./src/ingest.ts",
			"default": "./src/ingest.ts"
		},
		"./direct-ingest": {
			"bun": "./src/direct-ingest.ts",
			"types": "./src/direct-ingest.ts",
			"default": "./src/direct-ingest.ts"
		},
		"./credentials": {
			"bun": "./src/credentials.ts",
			"types": "./src/credentials.ts",
			"default": "./src/credentials.ts"
		},
		"./operator": {
			"bun": "./src/operator.ts",
			"types": "./src/operator.ts",
			"default": "./src/operator.ts"
		},
		"./operator-api": {
			"bun": "./src/operator-api.ts",
			"types": "./src/operator-api.ts",
			"default": "./src/operator-api.ts"
		},
		"./gates": {
			"bun": "./src/gates.ts",
			"types": "./src/gates.ts",
			"default": "./src/gates.ts"
		},
		"./access": {
			"bun": "./src/access.ts",
			"types": "./src/access.ts",
			"default": "./src/access.ts"
		},
		"./catalog": {
			"bun": "./src/catalog.ts",
			"types": "./src/catalog.ts",
			"default": "./src/catalog.ts"
		},
		"./releases": {
			"bun": "./src/releases.ts",
			"types": "./src/releases.ts",
			"default": "./src/releases.ts"
		},
		"./artifact-upload": {
			"bun": "./src/artifact-upload.ts",
			"types": "./src/artifact-upload.ts",
			"default": "./src/artifact-upload.ts"
		},
		"./testing": {
			"bun": "./src/testing.ts",
			"types": "./src/testing.ts",
			"default": "./src/testing.ts"
		},
		"./consumer": {
			"bun": "./src/consumer.ts",
			"types": "./src/consumer.ts",
			"default": "./src/consumer.ts"
		},
		"./platform-cf": {
			"bun": "./src/platform-cf.ts",
			"types": "./src/platform-cf.ts",
			"default": "./src/platform-cf.ts"
		},
		"./node/consumer": {
			"bun": "./src/node/consumer.ts",
			"types": "./src/node/consumer.ts",
			"default": "./src/node/consumer.ts"
		},
		"./node/migrate": {
			"bun": "./src/node/migrate.ts",
			"types": "./src/node/migrate.ts",
			"default": "./src/node/migrate.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test src/__tests__",
		"migrate:postgres": "bun src/node/migrate.ts"
	},
	"dependencies": {
		"@fabrika/app": "workspace:*",
		"@fabrika/auth": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/operations-contract": "workspace:*",
		"@fabrika/platform": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"@fabrika/provider-cloudflare": "workspace:*",
		"source-map-js": "^1.2.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/bun": "latest",
		"jose": "^5.9.0",
		"oblaka-iac": "^0.0.18",
		"wrangler": "^4.24.0"
	}
}
