{
	"name": "@fabrika/cli",
	"version": "0.0.4",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/cli"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"fabrika": "./src/index.ts"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@fabrika/installation-cloudflare": "workspace:*",
		"@fabrika/installation-contract": "workspace:*",
		"@fabrika/installation-zerops": "workspace:*",
		"@fabrika/provider-cloudflare": "workspace:*",
		"@fabrika/provider-contract": "workspace:*",
		"@fabrika/provider-zerops": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
