{
	"name": "@fabrika/cli",
	"version": "0.9.0-dev.4",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/cli"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"fabrika": "./src/index.ts"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"zod": "^3.25.76",
		"@fabrika/app": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/control-contract": "workspace:*",
		"@fabrika/provider-contract": "workspace:*",
		"@fabrika/db": "workspace:*",
		"@fabrika/platform": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"@fabrika/check": "workspace:*"
	},
	"peerDependencies": {
		"@fabrika/builder": "workspace:*",
		"@fabrika/provider-cloudflare": "workspace:*",
		"@fabrika/provider-zerops": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@fabrika/builder": {
			"optional": true
		},
		"@fabrika/provider-cloudflare": {
			"optional": true
		},
		"@fabrika/provider-zerops": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@fabrika/builder": "workspace:*",
		"@fabrika/provider-cloudflare": "workspace:*",
		"@fabrika/provider-zerops": "workspace:*"
	}
}
