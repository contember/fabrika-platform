{
	"name": "@fabrika/proxy",
	"version": "0.0.4",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/proxy"
	},
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"dev": "bun run src/main.ts",
		"build": "bun run src/generate-config.ts && bun build --compile --target=bun-linux-x64-musl ./src/main.ts --outfile ./dist/fabrika-proxy",
		"build:check": "bun run src/generate-config.ts ./fixtures/empty.manifest.json ./dist/caddy.json && bun build --compile --target=bun-linux-x64-musl ./src/main.ts --outfile ./dist/fabrika-proxy"
	},
	"dependencies": {
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/proxy-contract": "workspace:*",
		"@fabrika/proxy-core": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
