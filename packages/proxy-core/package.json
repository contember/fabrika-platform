{
	"name": "@fabrika/proxy-core",
	"version": "0.8.2",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/proxy-core"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./manifest": {
			"bun": "./src/manifest.ts",
			"types": "./src/manifest.ts",
			"default": "./src/manifest.ts"
		},
		"./headers": {
			"bun": "./src/headers.ts",
			"types": "./src/headers.ts",
			"default": "./src/headers.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"zod": "^3.25.76",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/jwks": "workspace:*",
		"jose": "^5.9.0",
		"@fabrika/platform": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3"
	}
}
