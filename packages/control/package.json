{
	"name": "@fabrika/control",
	"version": "0.0.4",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./gates": {
			"bun": "./fabrika.gates.ts",
			"types": "./fabrika.gates.ts",
			"default": "./fabrika.gates.ts"
		},
		"./schema": {
			"bun": "./fabrika.schema.ts",
			"types": "./fabrika.schema.ts",
			"default": "./fabrika.schema.ts"
		},
		"./api/provider-envelope": {
			"bun": "./src/api/provider-envelope.ts",
			"types": "./src/api/provider-envelope.ts",
			"default": "./src/api/provider-envelope.ts"
		},
		"./github-connection-store": {
			"bun": "./src/github-connection-store.ts",
			"types": "./src/github-connection-store.ts",
			"default": "./src/github-connection-store.ts"
		},
		"./iam-admin": {
			"bun": "./src/iam-admin.ts",
			"types": "./src/iam-admin.ts",
			"default": "./src/iam-admin.ts"
		},
		"./repo-source": {
			"bun": "./src/repo-source.ts",
			"types": "./src/repo-source.ts",
			"default": "./src/repo-source.ts"
		},
		"./lease": {
			"bun": "./src/lease.ts",
			"types": "./src/lease.ts",
			"default": "./src/lease.ts"
		},
		"./vault": {
			"bun": "./src/vault.ts",
			"types": "./src/vault.ts",
			"default": "./src/vault.ts"
		},
		"./source": {
			"bun": "./src/source/index.ts",
			"types": "./src/source/index.ts",
			"default": "./src/source/index.ts"
		},
		"./node/runtime": {
			"bun": "./src/node/runtime.ts",
			"types": "./src/node/runtime.ts",
			"default": "./src/node/runtime.ts"
		},
		"./node/server": {
			"bun": "./src/node/server.ts",
			"types": "./src/node/server.ts",
			"default": "./src/node/server.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"dev": "bunx lopata dev --env local --port 18291 --listen 0.0.0.0",
		"oblaka": "bunx oblaka oblaka.ts",
		"oblaka:deploy": "bunx oblaka oblaka.ts --remote",
		"bootstrap": "bun run scripts/bootstrap.ts",
		"seed": "bun run scripts/seed.ts",
		"serve": "bun src/node/server.ts",
		"migrate:postgres": "bun src/node/migrate.ts",
		"maintenance": "bun src/node/cron.ts"
	},
	"dependencies": {
		"@fabrika/app": "workspace:*",
		"@fabrika/auth": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/control-contract": "workspace:*",
		"@fabrika/github-app": "workspace:*",
		"@fabrika/operations-contract": "workspace:*",
		"@fabrika/platform": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"@fabrika/provider-cloudflare": "workspace:*",
		"@fabrika/provider-contract": "workspace:*",
		"@fabrika/provider-zerops": "workspace:*",
		"@fabrika/proxy-contract": "workspace:*",
		"@fabrika/runner-cloudflare": "workspace:*",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@fabrika/auth-core": "workspace:*",
		"@types/bun": "latest",
		"lopata": "^0.21.0",
		"oblaka-iac": "^0.0.18",
		"wrangler": "^4.24.0"
	}
}
