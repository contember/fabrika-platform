		"test": "bun test",
		"gen:schema": "bun scripts/generate-zerops-types.ts"
	},
	"dependencies": {
		"@fabrika/auth": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/provider-contract": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
