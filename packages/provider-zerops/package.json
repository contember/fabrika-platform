{
	"name": "@fabrika/provider-zerops",
	"version": "0.0.1",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/provider-zerops"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"fabrika-zerops": "./src/cli.ts"
