{
	"manifestVersion": 3,
	"app": {
		"id": "crm",
		"env": "prod",
		"schema": {
			"scopes": [
				{
					"type": "company",
					"in": "org"
				},
				{
					"type": "contact",
					"in": "company"
				},
				{
					"type": "deal",
					"in": "company"
				},
				{
					"type": "org",
					"members": {
						"manage": "members.manage",
						"list": "crm.read"
					},
					"directory": "labels",
					"lookups": [
						"activities.write",
						"crm.delete",
						"crm.read",
						"crm.write",
						"deals.assign",
						"deals.write",
						"tasks.write"
					]
				},
				{
					"type": "task",
					"in": "deal"
				}
			],
			"actions": [
				{
					"action": "activities.write",
					"description": "Log activities on contacts and deals"
				},
				{
					"action": "crm.delete",
					"description": "Delete companies, contacts, deals and attachments"
				},
				{
					"action": "crm.read",
					"description": "Read companies, contacts, deals, tasks, activities, attachments and the members of an org"
				},
				{
					"action": "crm.write",
					"description": "Create and edit companies and contacts"
				},
				{
					"action": "deals.assign",
					"description": "Choose the owner of a deal"
				},
				{
					"action": "deals.write",
					"description": "Create deals, edit them, move them through the pipeline and attach files"
				},
				{
					"action": "members.manage",
					"description": "Invite and remove the members of an org"
				},
				{
					"action": "tasks.write",
					"description": "Create tasks and mark them done"
				}
			],
			"roles": {
				"manager": {
					"name": "manager",
					"permissions": [
						"activities.write",
						"crm.delete",
						"crm.read",
						"crm.write",
						"deals.assign",
						"deals.write",
						"members.manage",
						"tasks.write"
					],
					"member": {
						"scope": "org",
						"assignableBy": [
							"manager"
						]
					}
				},
				"sales": {
					"name": "sales",
					"permissions": [
						"activities.write",
						"crm.read",
						"deals.write",
						"tasks.write"
					],
					"member": {
						"scope": "org",
						"assignableBy": [
							"manager"
						]
					}
				},
				"viewer": {
					"name": "viewer",
					"permissions": [
						"crm.read"
					],
					"member": {
						"scope": "org",
						"assignableBy": [
							"manager"
						]
					}
				}
			},
			"contract": true,
			"links": {},
			"delegations": {},
			"workloads": [
				{
					"kind": "job",
					"name": "overdue",
					"actions": [
						"crm.read",
						"tasks.write"
					]
				}
			]
		},
		"pipeline": {
			"secrets": [],
			"vars": []
		}
	},
	"target": {
		"platform": "zerops",
		"sourceDescriptor": {
			"path": "zerops.yaml",
			"contents": "# The build descriptor Zerops reads from the repository root. A contract application authors only `setup`,\n# `build.base`, `build.os` and the SPA's `build.buildCommands`; the platform generates the rest (ADR-0043).\n\nzerops:\n  - setup: crmapi\n    build:\n      base: alpine/bun@1.3\n      buildCommands:\n        - bun install --frozen-lockfile\n        - bun run build:web\n",
			"sha256": "a4cbad489023a8acb7915e4da6247730b7966fd24cd041a0b58286d8c2bfe9ff"
		},
		"importDocument": {
			"services": [
				{
					"hostname": "crmdb",
					"type": "postgresql:single@18",
					"envIsolation": "service",
					"override": true,
					"priority": 100,
					"profile": "oltp-hobby"
				},
				{
					"hostname": "crmfiles",
					"type": "object-storage",
					"envIsolation": "service",
					"override": true,
					"objectStorageSize": 1,
					"priority": 50,
					"objectStoragePolicy": "private"
				},
				{
					"hostname": "crmapi",
					"type": "alpine/bun@1.3",
					"envIsolation": "service",
					"override": true,
					"enableSubdomainAccess": false,
					"priority": 10,
					"minContainers": 1,
					"maxContainers": 2
				}
			]
		},
		"deployService": "crmapi",
		"zeropsSetup": "crmapi",
