{
	"name": "@fabrika/check",
	"version": "0.5.3",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/check"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"fabrika-check": "./src/cli.ts",
		"fabrika-source-maps": "./src/source-maps-cli.ts"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./contract": {
			"bun": "./src/contract.ts",
			"types": "./src/contract.ts",
			"default": "./src/contract.ts"
		},
		"./bun-plugin": {
			"bun": "./src/bun-plugin.ts",
			"types": "./src/bun-plugin.ts",
			"default": "./src/bun-plugin.ts"
		},
		"./source-maps": {
			"bun": "./src/source-maps.ts",
			"types": "./src/source-maps.ts",
			"default": "./src/source-maps.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@babel/parser": "8.0.7",
		"@fabrika/app": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/db": "workspace:*",
		"@fabrika/operations-contract": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"zod": "^3.25.76"
	}
}
