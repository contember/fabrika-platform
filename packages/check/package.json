{
	"name": "@fabrika/check",
	"version": "0.0.4",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/check"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"fabrika-check": "./src/cli.ts"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./contract": {
			"bun": "./src/contract.ts",
			"types": "./src/contract.ts",
			"default": "./src/contract.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@babel/parser": "8.0.7",
		"@fabrika/app": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"zod": "^3.25.76"
	}
}
