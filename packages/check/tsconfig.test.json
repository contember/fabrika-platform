{
	"extends": [
		"./tsconfig.json",
		"../../tsconfig.solution.json"
	],
	"compilerOptions": {
		"outDir": "${configDir}/.tsbuild/test",
		"composite": false,
		"noEmit": true,
		"emitDeclarationOnly": false
	},
	"include": [
		"src/**/__tests__/**/*",
		"src/**/*.test.ts",
		"src/**/*.test.tsx"
	],
	"exclude": [],
	"references": [
		{ "path": "../app/tsconfig.lib.json" },
		{ "path": "../app/tsconfig.test.json" },
		{ "path": "../auth-core/tsconfig.lib.json" },
		{ "path": "../auth-core/tsconfig.test.json" },
		{ "path": "./tsconfig.lib.json" },
		{ "path": "../db/tsconfig.lib.json" },
		{ "path": "../operations-contract/tsconfig.lib.json" },
		{ "path": "../provider-cloudflare/tsconfig.lib.json" },
		{ "path": "../provider-zerops/tsconfig.lib.json" },
		{ "path": "../ui/tsconfig.lib.json" }
	]
}
