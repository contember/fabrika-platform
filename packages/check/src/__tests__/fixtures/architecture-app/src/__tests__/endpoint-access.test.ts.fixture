// @generated by fabrika db test-scaffold sha256:1533ad7a782eba3022d51bffcf5de1bf24714df184114203468f72629d5b3d40
// The endpoint access tests of this application, written by fabrika db test-scaffold from fabrika.contract.ts and
// src/db/tables.ts. They run src/app.ts itself: callers of two scopes that share no value ask every endpoint with an
// access form, and a caller with only the endpoint's action asks for its own object. A handler bug that needs other
// data or another order is beyond them; the state a precondition needs is a seed in endpoint-access.fixtures.ts.
// Do not edit: @fabrika/check compares this file with what the scaffold writes; rerun it after a contract change.

import { afterAll, describe, endpointAccessKit, expect, test } from '@fabrika/app/testing/isolation'
import { testDatabase } from '@fabrika/db/testing'
import app from '../app'
import { tables } from '../db/tables'

const label = 'endpoint-access.test.ts'
const postgres = await testDatabase({ migrations: new URL('../../db/migrations/', import.meta.url), label })

if (postgres !== null) {
	afterAll(() => postgres.close())
	const kit = endpointAccessKit(app, tables, postgres)

	describe('endpoints: a caller of one scope reaches nothing of another', () => {
		test('api.companies.create: the org of another scope is 403', async () => {
			expect(await kit.denied('api.companies.create', { name: 'x', orgId: 'x' })).toEqual({ status: 403 })
		})

		test('api.companies.get: the company of another scope is 404', async () => {
			expect(await kit.denied('api.companies.get', { id: '00000000-0000-4000-8000-000000000000' })).toEqual({ status: 404 })
		})

		test('api.companies.get: the answer to one scope holds nothing of the scope answered before it', async () => {
			expect(await kit.leaked('api.companies.get', { id: '00000000-0000-4000-8000-000000000000' })).toEqual({ answered: true, leaked: [] })
		})

		test('api.deals.create: the company of another scope is 403', async () => {
			expect(await kit.denied('api.deals.create', { companyId: '00000000-0000-4000-8000-000000000000', title: 'x' })).toEqual({ status: 403 })
		})

		test('api.deals.pipeline: the org of another scope is 403', async () => {
			expect(await kit.denied('api.deals.pipeline', { orgId: 'x' })).toEqual({ status: 403 })
		})

		test('api.deals.pipeline: the answer to one scope holds nothing of the scope answered before it', async () => {
			expect(await kit.leaked('api.deals.pipeline', { orgId: 'x' })).toEqual({ answered: true, leaked: [] })
		})

		test('api.deals.reopen: the deal of another scope is 404', async () => {
			expect(await kit.denied('api.deals.reopen', { expectVersion: 1, id: '00000000-0000-4000-8000-000000000000' })).toEqual({ status: 404 })
		})

		test('api.deals.reopen: the answer to one scope holds nothing of the scope answered before it', async () => {
			expect(await kit.leaked('api.deals.reopen', { expectVersion: 1, id: '00000000-0000-4000-8000-000000000000' })).toEqual({ answered: true, leaked: [] })
		})

		test('api.deals.reopen: with its seed, the answer to one scope holds nothing of the scope answered before it', async () => {
			expect(await kit.leaked('api.deals.reopen', { expectVersion: 1, id: '00000000-0000-4000-8000-000000000000' }, { stage: 'won' })).toEqual({ answered: true, leaked: [] })
		})

		test('api.deals.reopen: a caller with only deals.write reaches its own deal', async () => {
			expect(await kit.own('api.deals.reopen', { expectVersion: 1, id: '00000000-0000-4000-8000-000000000000' }, { stage: 'won' })).toEqual({ status: 200 })
		})
	})
}
