import type { DB } from '../db/schema.generated'

/** A company as its endpoints answer it, read through the handle the handler passes in (`ctx.db.target`). */
export const companyOf = async (company: { get(): Promise<DB['companies']> }) => {
	const row = await company.get()
	return { id: row.id, name: row.name, version: row.version }
}
