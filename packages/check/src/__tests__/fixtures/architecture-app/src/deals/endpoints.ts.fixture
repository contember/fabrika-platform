import { ConflictError } from '@fabrika/app'
import { app } from '../app-kit'
import { NewDeal, OrgInput, Pipeline, PipelineRow, ReopenDeal, Saved } from '../schemas'
import { canReopen } from './logic'
import { lockedStage } from './queries'

export const deals = app.group({ callers: ['human'] }, (r) => ({
	create: r.mutation({ input: NewDeal, output: Saved, access: { action: 'deals.write', in: 'company', from: 'companyId' } })
		.handle(async ({ input, ctx }) => ctx.db.target.deals.insert({ title: input.title, stage: 'lead' })),
	reopen: r.mutation({ input: ReopenDeal, output: Saved, access: { action: 'deals.write', on: 'deal', from: 'id' } })
		.handle(async ({ input, ctx }) => {
			if (!canReopen(await lockedStage(ctx.db.target))) throw new ConflictError('only a won or lost deal reopens')
			return ctx.db.target.update({ stage: 'proposal' }, { expectVersion: input.expectVersion })
		}),
	pipeline: r.query({ input: OrgInput, output: Pipeline, access: { action: 'crm.read', in: 'org', from: 'orgId' }, sql: 'read' })
		.handle(async ({ ctx }) => ({
			rows: await ctx.sql(PipelineRow)`select d.stage, count(*)::int as deals from deals d
				join companies c on c.id = d.company_id where c.org_id = ${ctx.target.value} group by d.stage`,
		})),
}))
