import { z } from 'zod/v4'

export const ById = z.strictObject({ id: z.uuid() })
export const Note = z.strictObject({
	id: z.uuid(),
	title: z.string().min(1).max(200),
	body: z.string(),
	version: z.int().nonnegative(),
})
export const NoteList = z.strictObject({ items: z.array(Note) })
export const CreateNote = z.strictObject({ workspaceId: z.uuid(), title: z.string().min(1), body: z.string() })
export const Deleted = z.strictObject({ deleted: z.uuid() })
export const Limits = { maxTitle: 200, tags: ['a', 'b'] } as const

// violations inside a schema module
const prefix = 'note'
export const Slug = z.string().regex(new RegExp(`^${prefix}-`))
export const Trimmed = z.string().transform((s) => s.trim())
