{
	"name": "@fabrika/db",
	"version": "0.9.0-dev.5",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/db"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./capability": {
			"bun": "./src/capability.ts",
			"types": "./src/capability.ts",
			"default": "./src/capability.ts"
		},
		"./tables": {
			"bun": "./src/tables.ts",
			"types": "./src/tables.ts",
			"default": "./src/tables.ts"
		},
		"./framework": {
			"bun": "./src/framework.ts",
			"types": "./src/framework.ts",
			"default": "./src/framework.ts"
		},
		"./migrations": {
			"bun": "./src/migrations.ts",
			"types": "./src/migrations.ts",
			"default": "./src/migrations.ts"
		},
		"./migrations-sqlite": {
			"bun": "./src/migrations-sqlite.ts",
			"types": "./src/migrations-sqlite.ts",
			"default": "./src/migrations-sqlite.ts"
		},
		"./production": {
			"bun": "./src/production.ts",
			"types": "./src/production.ts",
			"default": "./src/production.ts"
		},
		"./postgres": {
			"bun": "./src/postgres.ts",
			"types": "./src/postgres.ts",
			"default": "./src/postgres.ts"
		},
		"./sqlite": {
			"bun": "./src/sqlite.ts",
			"types": "./src/sqlite.ts",
			"default": "./src/sqlite.ts"
		},
		"./sqlite-migrate": {
			"bun": "./src/sqlite-migrate.ts",
			"types": "./src/sqlite-migrate.ts",
			"default": "./src/sqlite-migrate.ts"
		},
		"./codegen-sqlite": {
			"bun": "./src/codegen-sqlite.ts",
			"types": "./src/codegen-sqlite.ts",
			"default": "./src/codegen-sqlite.ts"
		},
		"./testing-sqlite": {
			"bun": "./src/testing-sqlite.ts",
			"types": "./src/testing-sqlite.ts",
			"default": "./src/testing-sqlite.ts"
		},
		"./codegen": {
			"bun": "./src/codegen.ts",
			"types": "./src/codegen.ts",
			"default": "./src/codegen.ts"
		},
		"./testing": {
			"bun": "./src/testing.ts",
			"types": "./src/testing.ts",
			"default": "./src/testing.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/platform": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"kysely": "0.29.6",
		"kysely-postgres-js": "5.0.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"typescript": "^5.9.3",
		"@fabrika/check": "workspace:*"
	}
}
