{
	"name": "agent-canvas",
	"version": "0.9.0-dev.11",
	"description": "Interactive visual canvas for Claude Code — rich annotatable documents in the browser",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/agent-canvas"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"agent-canvas": "./bin/agent-canvas.js"
	},
	"files": [
		"bin",
		"daemon",
		"daemon/dist",
		"skills"
	],
	"exports": {
		"./package.json": "./package.json",
		"./review/model": "./daemon/src/review/model.ts",
		"./review/remote": "./daemon/src/review/remote.ts",
		"./review/sealing": "./daemon/src/review/sealing.ts",
		"./review/threads": "./daemon/src/review/threads.ts"
	},
	"scripts": {
		"build": "bun daemon/build.ts",
		"release:prepare": "bun run build",
		"typecheck": "tsc --build tsconfig.build.json daemon/tsconfig.build.json daemon/review-widget/tsconfig.build.json",
		"test": "bun test"
	},
	"dependencies": {
		"@fabrika/annotations": "workspace:*",
		"@fabrika/canvas-kernel": "workspace:*",
		"@fabrika/daemon-kit": "workspace:*",
		"@jridgewell/trace-mapping": "^0.3.31",
		"marked": "^17.0.4",
		"mermaid-parser-bundle": "^0.1.2",
		"preact": "^10.25.0",
		"preact-render-to-string": "^6.6.6",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@tailwindcss/cli": "4",
		"@types/bun": "^1.4.3",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"tailwindcss": "4",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"claude-code",
		"canvas",
		"interactive",
		"annotations"
	]
}
