{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"paths": {
			"#canvas/components": ["./src/client/components/index.ts"],
			"#canvas/runtime": ["./src/client/runtime.ts"]
		},
		"types": ["@types/bun"]
	},
	"include": ["index.ts", "src/**/*"],
	"exclude": ["src/client/preact-all.ts"]
}
