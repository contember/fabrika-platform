{
	"name": "@fabrika/installation-zerops",
	"version": "0.0.3",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/installation-zerops"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**",
		"zerops",
		"!zerops/**/__tests__/**",
		"!zerops/proxy-manifest.ts",
		"!zerops/console-schema.ts",
		"!zerops/render.ts"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"gen": "bun zerops/render.ts",
		"gen:check": "bun zerops/render.ts --check",
		"gen:schemas": "bun zerops/schemas/refresh.ts"
	},
	"dependencies": {
		"@fabrika/auth": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/installation-contract": "workspace:*",
		"@fabrika/installation-init": "workspace:*",
		"@fabrika/provider-contract": "workspace:*",
		"@fabrika/provider-zerops": "workspace:*",
		"@fabrika/proxy-contract": "workspace:*"
	},
	"devDependencies": {
		"@fabrika/control": "workspace:*",
		"@fabrika/engine": "workspace:*",
		"@fabrika/example-zerops-app": "workspace:*",
		"@fabrika/operations": "workspace:*",
		"@fabrika/operations-contract": "workspace:*",
		"@fabrika/proxy": "workspace:*",
		"@types/bun": "latest"
	}
}
