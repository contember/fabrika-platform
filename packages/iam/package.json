{
	"name": "@fabrika/iam",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./admin": {
			"bun": "./src/admin/types.ts",
			"types": "./src/admin/types.ts",
			"default": "./src/admin/types.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"dev": "bunx lopata dev --env local --port 18191 --listen 0.0.0.0",
		"oblaka": "bunx oblaka oblaka.ts",
		"oblaka:deploy": "bunx oblaka oblaka.ts --remote",
		"serve": "bun src/node/server.ts",
		"migrate:postgres": "bun src/node/migrate.ts",
		"prune:auth-log": "bun src/node/prune.ts"
	},
	"dependencies": {
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/config": "workspace:*",
		"@fabrika/platform": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"jose": "^5.9.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/bun": "latest",
		"lopata": "latest",
		"oblaka-iac": "^0.0.18",
		"wrangler": "^4.24.0"
	}
}
