{
	"name": "@fabrika/iam",
	"version": "0.4.5",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./service": {
			"bun": "./src/service.ts",
			"types": "./src/service.ts",
			"default": "./src/service.ts"
		},
		"./node/runtime": {
			"bun": "./src/node/runtime.ts",
			"types": "./src/node/runtime.ts",
			"default": "./src/node/runtime.ts"
		},
		"./node/server": {
			"bun": "./src/node/server.ts",
			"types": "./src/node/server.ts",
			"default": "./src/node/server.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"dev": "bunx lopata dev --env local --port 18191 --listen 0.0.0.0",
		"oblaka": "bunx oblaka oblaka.ts",
		"deploy:cloudflare": "fabrika app deploy --provider=cloudflare",
		"serve": "bun src/node/server.ts",
		"migrate:postgres": "bun src/node/migrate.ts",
		"prune:auth-log": "bun src/node/prune.ts"
	},
	"dependencies": {
		"@fabrika/app": "workspace:*",
		"@fabrika/auth": "workspace:*",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/email": "workspace:*",
		"@fabrika/iam-contract": "workspace:*",
		"@fabrika/platform": "workspace:*",
		"@fabrika/platform-node": "workspace:*",
		"jose": "^5.9.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@fabrika/cli": "workspace:*",
		"@fabrika/db": "workspace:*",
		"@fabrika/provider-cloudflare": "workspace:*",
		"@fabrika/proxy-core": "workspace:*",
		"@types/bun": "latest",
		"lopata": "^0.21.0",
		"oblaka-iac": "^0.0.18",
		"wrangler": "^4.24.0"
	}
}
