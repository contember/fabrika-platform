@@ -0,0 +1,10 @@
+-- A label carries its note's workspace; the composite foreign key keeps it in the note's scope when the note moves.
+CREATE TABLE note_labels (
+	id UUID PRIMARY KEY,
+	note_id UUID NOT NULL,
+	workspace_id TEXT NOT NULL,
+	name TEXT NOT NULL,
+	FOREIGN KEY (note_id, workspace_id) REFERENCES notes (id, workspace_id) ON UPDATE CASCADE ON DELETE CASCADE
+);
+
+CREATE INDEX note_labels_note ON note_labels (note_id);
diff --git a/db/migrations/20261010090100_note_titles.sql b/db/migrations/20261010090100_note_titles.sql
new file mode 100644
index 0000000..8b796ed
--- /dev/null
+++ b/db/migrations/20261010090100_note_titles.sql
@@ -0,0 +1,10 @@
+-- A note's title is stored trimmed, whoever writes it: database code, which this migration declares.
+CREATE FUNCTION notes_trim_title() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+	NEW.title := btrim(NEW.title);
+	RETURN NEW;
+END
+$$;
+
+CREATE TRIGGER notes_trim_title BEFORE INSERT OR UPDATE OF title ON notes
+	FOR EACH ROW EXECUTE FUNCTION notes_trim_title();
