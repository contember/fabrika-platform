+// @generated by fabrika db test-scaffold sha256:ba24f480af7ff92c3ca30d22720bd0bbeb5184df4199bf519d37ad8d0ae607f2
+// The policy isolation tests of note_labels, written by fabrika db test-scaffold from src/db/tables.ts. They prove that
+// the data layer enforces the policy, through a probe of their own: the application's handlers and stores do not run.
+// Do not edit: @fabrika/check compares this file with what the scaffold writes; rerun it after a policy change.
+
+import { afterAll, describe, expect, policyIsolationKit, test } from '@fabrika/app/testing/isolation'
+import { testDatabase } from '@fabrika/db/testing'
+import { contract } from '../../../fabrika.contract'
+import { tables } from '../tables'
+
+const label = 'note_labels.policy-isolation.test.ts'
+const postgres = await testDatabase({ migrations: new URL('../../../db/migrations/', import.meta.url), label })
+
+if (postgres !== null) {
+	afterAll(() => postgres.close())
+	const kit = policyIsolationKit(contract, tables, 'note_labels', postgres)
+
+	describe('policy of note_labels: a caller of one workspace reaches no row of another', () => {
+		test('get answers its own row', async () => {
+			expect((await kit.get('own')).status).toBe(200)
+		})
+
+		test('get of a row in another workspace is 404', async () => {
+			expect((await kit.get('other')).status).toBe(404)
+		})
+
+		test('get of a key in another workspace through its own parent is 404', async () => {
+			expect((await kit.get('crossed')).status).toBe(404)
+		})
+
+		test('a list by its own parent reaches only its own row', async () => {
+			expect(await kit.listByParent('own')).toEqual({ status: 200, rows: ['own'] })
+		})
+
+		test('a list by a parent in another workspace is 404', async () => {
+			expect((await kit.listByParent('other')).status).toBe(404)
+		})
+
+		test('a list reaches only its own row', async () => {
+			expect(await kit.list()).toEqual({ status: 200, rows: ['own'] })
+		})
+
+		test('a count counts only its own row', async () => {
+			expect(await kit.count()).toEqual({ status: 200, count: '1' })
+		})
+
+		test('insert into its own workspace succeeds', async () => {
+			expect((await kit.insert('own')).status).toBe(200)
+		})
+
+		test('insert into another workspace is 403', async () => {
+			expect((await kit.insert('other')).status).toBe(403)
+		})
+
+		test('update of its own row succeeds', async () => {
+			expect((await kit.update('own')).status).toBe(200)
+		})
+
+		test('update of a row in another workspace is 404', async () => {
+			expect((await kit.update('other')).status).toBe(404)
+		})
+
+		test('update of a key in another workspace through its own parent is 404', async () => {
+			expect((await kit.update('crossed')).status).toBe(404)
+		})
+
+		test('update refuses a Ref for notes.read', async () => {
+			expect(await kit.updateWithRead()).toEqual({ status: 200, refused: true })
+		})
+
+		test('remove of its own row succeeds', async () => {
+			expect((await kit.remove('own')).status).toBe(200)
+		})
+
+		test('remove of a row in another workspace is 404', async () => {
+			expect((await kit.remove('other')).status).toBe(404)
+		})
+
+		test('remove of a key in another workspace through its own parent is 404', async () => {
+			expect((await kit.remove('crossed')).status).toBe(404)
+		})
+
+		test('remove refuses a Ref for notes.read', async () => {
+			expect(await kit.removeWithRead()).toEqual({ status: 200, refused: true })
+		})
+	})
+}
