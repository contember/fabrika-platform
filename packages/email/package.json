{
	"name": "@fabrika/email",
	"version": "0.4.8",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contember/fabrika-platform.git",
		"directory": "packages/email"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./resend": {
			"bun": "./src/resend.ts",
			"types": "./src/resend.ts",
			"default": "./src/resend.ts"
		},
		"./directory": {
			"bun": "./src/directory.ts",
			"types": "./src/directory.ts",
			"default": "./src/directory.ts"
		},
		"./memory": {
			"bun": "./src/memory.ts",
			"types": "./src/memory.ts",
			"default": "./src/memory.ts"
		},
		"./smartemailing": {
			"bun": "./src/smartemailing.ts",
			"types": "./src/smartemailing.ts",
			"default": "./src/smartemailing.ts"
		},
		"./providers": {
			"bun": "./src/providers.ts",
			"types": "./src/providers.ts",
			"default": "./src/providers.ts"
		},
		"./conformance": {
			"bun": "./src/conformance.ts",
			"types": "./src/conformance.ts",
			"default": "./src/conformance.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test src/__tests__"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"dependencies": {
		"zod": "^3.25.76"
	}
}
