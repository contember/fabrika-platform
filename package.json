{
	"name": "fabrika-platform",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"typecheck": "bun run --filter '*' typecheck && tsc --project scripts/tsconfig.json",
		"test": "bun test --path-ignore-patterns='tests/browser/**' --path-ignore-patterns='packages/annotations/**' --path-ignore-patterns='packages/builder/**' --path-ignore-patterns='packages/canvas-kernel/**' --path-ignore-patterns='packages/daemon-kit/**' --path-ignore-patterns='packages/ui/**' --path-ignore-patterns='packages/app/src/react/**' --path-ignore-patterns='examples/zerops-app/**' --path-ignore-patterns='examples/crm/**' --path-ignore-patterns='examples/app/**' && bun run test:agent-interfaces && bun run test:dom && bun run test:examples && bun run test:builder",
		"test:agent-interfaces": "bun test --isolate packages/annotations packages/canvas-kernel packages/daemon-kit",
		"test:dom": "bun test --isolate packages/ui packages/app/src/react",
		"test:builder": "bun run --filter @fabrika/builder test",
		"test:examples": "bun run --cwd examples/zerops-app test && bun run --cwd examples/crm test && bun run --cwd examples/app test",
		"test:live": "bun test packages/provider-zerops/src/__tests__/platform-facts.live.test.ts",
		"check:ci": "bun scripts/check-ci.ts",
		"lint": "biome lint .",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"release:validate": "bun scripts/release.ts validate",
		"release:pack": "bun scripts/release.ts pack",
		"release:smoke": "bun scripts/release.ts smoke",
		"release:publish": "bun scripts/release.ts publish",
		"release:registry-smoke": "bun scripts/release.ts registry-smoke",
		"release:example-pin": "bun scripts/release.ts example-pin",
		"release:bump": "bun scripts/release.ts bump",
		"release:hotfix": "bun scripts/release.ts hotfix",
		"local:up": "bun run --filter @fabrika/local-stack up",
		"local:status": "bun run --filter @fabrika/local-stack status",
		"local:smoke": "bun run --filter @fabrika/local-stack smoke",
		"local:compat": "bun run --filter @fabrika/local-stack compat",
		"local:reset": "bun run --filter @fabrika/local-stack reset",
		"local:down": "bun run --filter @fabrika/local-stack down",
		"browser:up": "bun run --filter @fabrika/local-stack browser:up",
		"browser:reset": "bun run --filter @fabrika/local-stack browser:reset",
		"browser:down": "bun run --filter @fabrika/local-stack browser:down",
		"test:browser": "bun run --filter @fabrika/local-stack browser:test"
	},
	"devDependencies": {
		"zod": "^3.25.76",
		"@biomejs/biome": "^2.5.6",
		"@fabrika/auth-core": "workspace:*",
		"@fabrika/cli": "workspace:*",
		"@fabrika/local-stack": "workspace:*",
		"@fabrika/operations-contract": "workspace:*",
		"@opice/cli": "0.11.0",
		"@opice/harness": "0.11.0",
		"@types/bun": "^1.4.3",
		"dprint": "^0.51.1",
		"playwright": "^1.60.0",
		"typescript": "^5.9.3"
	},
	"license": "MIT"
}
