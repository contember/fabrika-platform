{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"useTabs": true,
	"typescript": {
		"semiColons": "asi",
		"indentWidth": 1,
		"lineWidth": 150,
		"quoteStyle": "preferSingle",
		"jsx.quoteStyle": "preferDouble",
	},
	"json": {
		"trailingCommas": "maintain",
	},
	"markdown": {
	},
	"toml": {
	},
	"dockerfile": {
	},
	"excludes": [
		"**/node_modules",
		"**/*-lock.json",
		".claude",
		// What `fabrika app build` writes from the SQLite migrations, verbatim, so their checksums stay the files'.
		"**/fabrika/migrations.generated.ts",
		// What `fabrika db test-scaffold` writes: the checker compares it byte for byte (`generated-test-hash`).
		"examples/*/src/__tests__/endpoint-access.test.ts",
		"examples/*/src/db/__tests__/*.policy-isolation.test.ts",
		"packages/cli/src/__tests__/fixtures/*/src/__tests__/endpoint-access.test.ts",
		"packages/cli/src/__tests__/fixtures/*/src/db/__tests__/*.policy-isolation.test.ts",
		"packages/app/src/__tests__/members-fixture/src/__tests__/endpoint-access.test.ts",
		"packages/app/src/__tests__/members-fixture/src/db/__tests__/*.policy-isolation.test.ts",
		"packages/app/src/__tests__/app-wide-fixture/src/__tests__/endpoint-access.test.ts",
		"packages/app/src/__tests__/app-wide-fixture/src/db/__tests__/*.policy-isolation.test.ts"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.95.11.wasm",
		"https://plugins.dprint.dev/json-0.20.0.wasm",
		"https://plugins.dprint.dev/markdown-0.19.0.wasm",
		"https://plugins.dprint.dev/toml-0.7.0.wasm",
		"https://plugins.dprint.dev/dockerfile-0.3.3.wasm"
	]
}
