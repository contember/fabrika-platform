{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": [
			"@types/bun"
		]
	},
	"include": [
		"src/**/*",
		"web/**/*",
		"*.ts"
	]
}
