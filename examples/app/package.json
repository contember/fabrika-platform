{
	"name": "fabrika-example-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "fabrika app build --provider=cloudflare",
		"build:web": "bun build-web.ts",
		"check": "fabrika-check .",
		"dev": "bunx lopata dev --env local --port 18190 --listen 127.0.0.1",
		"oblaka": "bunx oblaka oblaka.ts",
		"test": "bun test --isolate",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fabrika/app": "0.9.0-dev.9",
		"@fabrika/auth-core": "0.9.0-dev.9",
		"@fabrika/db": "0.9.0-dev.9",
		"@fabrika/provider-cloudflare": "0.9.0-dev.9",
		"@fabrika/proxy-core": "0.9.0-dev.9",
		"kysely": "0.29.6",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@fabrika/check": "0.9.0-dev.9",
		"@fabrika/cli": "0.9.0-dev.9",
		"@fabrika/platform": "0.9.0-dev.9",
		"@types/bun": "^1.4.3",
		"lopata": "^0.30.1",
		"oblaka-iac": "^0.0.18",
		"typescript": "^5.9.3",
		"wrangler": "^4.74.0"
	}
}
