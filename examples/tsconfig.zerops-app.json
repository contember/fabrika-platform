		"composite": true,
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": false,
		"sourceMap": false,
		"rootDir": "./zerops-app",
		"outDir": "./.tsbuild/zerops-app",
		"tsBuildInfoFile": "./.tsbuild/zerops-app/tsconfig.tsbuildinfo",
